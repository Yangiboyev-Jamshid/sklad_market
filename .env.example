# Turns the AI agent surfaces on (AI page, home assistant, AI search panel, similar products).
# Off by default; requires the backend /api/v1/ai/** gateway route to be live.
VITE_FEATURE_AI_AGENT=false

# Optional: point the local Vite dev proxy at your own gateway instead of the shared backend.
# The browser still calls relative /api/v1 URLs. Defaults to https://skladmarket.uz.
# VITE_API_PROXY_TARGET=http://localhost:8080
